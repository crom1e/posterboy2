# MQTT Broker Configuration
# Set these environment variables for your deployment
# Copy to .env and update with your actual values (do NOT commit .env)

# MQTT broker URL (required)
# Examples:
#   mqtt://broker.example.com:1883 (native MQTT)
#   ws://broker.example.com:9001 (WebSocket)
#   mqtt://192.168.66.199:1883 (local network)
MQTT_BROKER_URL=mqtt://mqtt-broker:1883

# MQTT credentials (optional)
# MQTT_USERNAME=username
# MQTT_PASSWORD=password

# Docker port mapping (optional, default: 3000)
# PORT=3000
